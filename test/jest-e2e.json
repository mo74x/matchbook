{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.\\./)*generated/prisma/(.*)\\.(js|ts)$": "<rootDir>/../generated/prisma/$2",
    "^generated/prisma/(.*)$": "<rootDir>/../generated/prisma/$1",
    "^(\\.\\./)*generated/prisma$": "<rootDir>/../generated/prisma/client"
  }
}
